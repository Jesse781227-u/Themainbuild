rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member(businessId) {
      return request.auth != null && exists(/databases/$(database)/documents/businessMemberships/$(request.auth.uid + '_' + businessId));
    }
    match /products/{id} { allow read: if resource.data.get('available', false) == true || resource.data.get('availability', false) == true || member(resource.data.businessId); allow create, update: if member(request.resource.data.businessId); allow delete: if member(resource.data.businessId); }
    match /categories/{id} { allow read: if member(resource.data.businessId); allow create, update: if member(request.resource.data.businessId); allow delete: if member(resource.data.businessId); }
    match /inventory/{id} { allow read: if member(resource.data.businessId); allow create, update: if member(request.resource.data.businessId); allow delete: if member(resource.data.businessId); }
    match /carts/{id} { allow read: if member(resource.data.businessId); allow create, update: if member(request.resource.data.businessId); allow delete: if member(resource.data.businessId); }
    match /orders/{id} { allow read: if member(resource.data.businessId); allow create, update: if member(request.resource.data.businessId); allow delete: if member(resource.data.businessId); }
    match /payments/{id} { allow read: if member(resource.data.businessId); allow create, update: if member(request.resource.data.businessId); allow delete: if member(resource.data.businessId); }
    match /customers/{id} { allow read: if member(resource.data.businessId); allow create, update: if member(request.resource.data.businessId); allow delete: if member(resource.data.businessId); }
    match /storefronts/{slug} { allow read: if resource.data.published == true || member(resource.data.businessId); allow create, update: if member(request.resource.data.businessId); allow delete: if member(resource.data.businessId); }
    match /businessMemberships/{id} { allow read: if request.auth != null && resource.data.userId == request.auth.uid; allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
