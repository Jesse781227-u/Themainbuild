rules_version = '2';
// Uploads happen only through relay-api (Admin SDK). Product images stay publicly readable because
// WhatsApp and Instagram fetch carousel and product images by URL.
service firebase.storage {
  match /b/{bucket}/o {
    match /businesses/{businessId}/products/{file} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
