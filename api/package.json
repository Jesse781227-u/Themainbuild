{
  "name": "relay-api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc && wrangler deploy --dry-run --outdir dist --env=\"\"",
    "typecheck": "tsc",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:tracker": "node --import tsx --test --test-concurrency=1 --test-reporter=tap \"test/**/*.test.ts\"",
    "test:emulators": "npx -y firebase-tools@14 --config ../firebase.json --project demo-relay emulators:exec --only firestore \"npm test\"",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "simulate": "tsx scripts/simulate-webhook.ts"
  },
  "dependencies": {
    "hono": "4.13.16",
    "pdf-lib": "^1.17.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.10.2",
    "firebase": "^11.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "4.156.1"
  }
}
